# ===========================================
# ENVIRONMENT VARIABLES FOR DEPLOYMENT
# ===========================================
# Copy this file to .env.local for local development
# For Vercel: Set these in Project Settings > Environment Variables
# ===========================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# App Configuration
# IMPORTANT: Set this to your production domain in Vercel
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LemonSqueezy Configuration (Optional - for payments)
# Get these from: https://app.lemonsqueezy.com/settings/api
# Note: Leave these empty if you're not using payments yet
LEMONSQUEEZY_API_KEY=your_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# DEPLOYMENT NOTES
# ===========================================
#
# REQUIRED FOR BASIC FUNCTIONALITY:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# - SUPABASE_SECRET_KEY
# - NEXT_PUBLIC_APP_URL
#
# OPTIONAL (can be added later):
# - LEMONSQUEEZY_* (only needed for payments)
#
# AFTER DEPLOYMENT:
# 1. Update Supabase OAuth callback URLs:
#    - Add: https://your-app.vercel.app/auth/callback
# 2. Update Google OAuth redirect URIs in Google Console:
#    - Add: https://your-project.supabase.co/auth/v1/callback
# ===========================================
